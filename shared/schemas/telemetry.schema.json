{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Telemetry",
  "description": "Drone state, published on ark/<droneId>/telemetry at 1 to 5 Hz (lower on LoRa / satellite).",
  "type": "object",
  "required": ["droneId", "ts", "position", "armed", "flightMode", "batteryPct"],
  "additionalProperties": false,
  "properties": {
    "droneId": { "$ref": "common.schema.json#/$defs/droneId" },
    "missionId": { "$ref": "common.schema.json#/$defs/missionId" },
    "ts": { "$ref": "common.schema.json#/$defs/timestamp" },
    "position": { "$ref": "common.schema.json#/$defs/geo" },
    "altAmslM": { "type": "number", "description": "Metres above mean sea level (position.altM is above home)." },
    "headingDeg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
    "rollDeg": { "type": "number", "minimum": -180, "maximum": 180, "description": "Right wing down is positive." },
    "pitchDeg": { "type": "number", "minimum": -90, "maximum": 90, "description": "Nose up is positive." },
    "groundSpeedMs": { "type": "number", "minimum": 0 },
    "climbRateMs": { "type": "number" },
    "armed": { "type": "boolean" },
    "flightMode": { "type": "string", "description": "ArduCopter mode name, e.g. AUTO, GUIDED, LAND, RTL." },
    "batteryPct": { "type": "number", "minimum": 0, "maximum": 100 },
    "batteryVoltageV": { "type": "number", "minimum": 0 },
    "batteryTempC": { "type": "number" },
    "motorTempC": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
    "vibration": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" }, "description": "x, y, z in m/s^2." },
    "rainIntensity": { "type": "number", "minimum": 0, "description": "mm/h." },
    "onWater": { "type": "boolean" },
    "moistureDetected": { "type": "boolean" },
    "pontoons": { "enum": ["stowed", "inflating", "inflated", "failed"] },
    "linkType": { "enum": ["lte", "lora", "satellite", "none"] },
    "linkQuality": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
