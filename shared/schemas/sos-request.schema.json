{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SosRequest",
  "type": "object",
  "required": [
    "id",
    "createdAt",
    "location",
    "channel"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "channel": {
      "enum": [
        "app",
        "sms",
        "whatsapp",
        "voice"
      ]
    },
    "language": {
      "type": "string"
    },
    "rawMessage": {
      "type": "string"
    },
    "photoUrl": {
      "type": "string"
    },
    "location": {
      "$ref": "#/$defs/geo"
    },
    "peopleCount": {
      "type": "integer",
      "minimum": 1
    },
    "needs": {
      "type": "array",
      "items": {
        "enum": [
          "food",
          "water",
          "medicine",
          "baby_supplies",
          "shelter",
          "rescue",
          "other"
        ]
      }
    },
    "medicalConditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "urgency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "aiSummary": {
      "type": "string"
    },
    "status": {
      "enum": [
        "new",
        "triaged",
        "assigned",
        "delivered",
        "closed"
      ]
    }
  },
  "$defs": {
    "geo": {
      "type": "object",
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        }
      }
    }
  }
}
