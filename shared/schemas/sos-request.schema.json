{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SosRequest",
  "description": "A call for help as stored: what the sender said (report), what sos-triage (Bedrock) concluded (triage), and where it is in the flow.",
  "type": "object",
  "required": ["id", "createdAt", "status", "report"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/sosId" },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "status": { "title": "SosStatus", "enum": ["new", "triaged", "assigned", "delivered", "closed"] },
    "report": { "$ref": "#/$defs/report" },
    "triage": { "$ref": "#/$defs/triage" },
    "missionId": { "$ref": "common.schema.json#/$defs/missionId" },
    "delivery": { "$ref": "#/$defs/delivery" }
  },
  "$defs": {
    "need": { "title": "Need", "enum": ["food", "water", "medicine", "baby_supplies", "shelter", "rescue", "other"] },
    "report": {
      "title": "SosReport",
      "description": "What the sender submits: the POST /sos body, or parsed from SMS / WhatsApp / voice.",
      "type": "object",
      "required": ["channel", "location"],
      "additionalProperties": false,
      "properties": {
        "channel": { "enum": ["app", "sms", "whatsapp", "voice"] },
        "location": { "$ref": "common.schema.json#/$defs/geo" },
        "language": { "type": "string", "description": "BCP 47 tag, e.g. ms, en, zh." },
        "rawMessage": { "type": "string", "maxLength": 4000 },
        "photoUrl": { "type": "string", "format": "uri" },
        "contactPhone": { "type": "string", "pattern": "^\\+[1-9][0-9]{6,14}$", "description": "E.164, used to reply." },
        "peopleCount": { "type": "integer", "minimum": 1 },
        "needs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/need" } },
        "medicines": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 },
          "description": "Medicines the sender asks for, in their words, e.g. insulin, paracetamol."
        },
        "vulnerable": { "$ref": "#/$defs/vulnerable" }
      }
    },
    "vulnerable": {
      "title": "SosVulnerable",
      "description": "How many of peopleCount need extra care. Drives what goes in the 2 kg kit (e.g. baby supplies).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "children": { "type": "integer", "minimum": 0 },
        "elderly": { "type": "integer", "minimum": 0 },
        "disabled": { "type": "integer", "minimum": 0 },
        "pregnant": { "type": "integer", "minimum": 0 }
      }
    },
    "delivery": {
      "title": "SosDelivery",
      "description": "The drone on its way, for the sender: GET /missions needs a staff JWT, so Ark SOS reads it here. Set once a mission is approved.",
      "type": "object",
      "required": ["droneId", "missionStatus"],
      "additionalProperties": false,
      "properties": {
        "droneId": { "$ref": "common.schema.json#/$defs/droneId" },
        "missionStatus": { "$ref": "mission.schema.json#/properties/status" },
        "etaMinutes": { "type": "number", "minimum": 0 },
        "payload": {
          "type": "array",
          "items": { "$ref": "mission.schema.json#/$defs/payloadItem" },
          "description": "What the drone carries for this SOS (the mission's kit), shown to the sender."
        },
        "payloadKg": { "$ref": "mission.schema.json#/properties/payloadKg" }
      }
    },
    "locationUpdate": {
      "title": "SosLocationUpdate",
      "description": "The sender's newer position. Ark SOS sends it in the background while help is on the way (POST /sos/{sosId}/location).",
      "type": "object",
      "required": ["location", "ts"],
      "additionalProperties": false,
      "properties": {
        "location": { "$ref": "common.schema.json#/$defs/geo" },
        "ts": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "triage": {
      "title": "SosTriage",
      "description": "sos-triage's Bedrock output. Validated against this schema before it is stored or acted on.",
      "type": "object",
      "required": ["urgency", "needs", "summary"],
      "additionalProperties": false,
      "properties": {
        "urgency": { "type": "integer", "minimum": 1, "maximum": 5, "description": "5 = life-threatening." },
        "needs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/need" } },
        "peopleCount": { "type": "integer", "minimum": 1 },
        "medicalConditions": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string", "maxLength": 1000, "description": "One or two sentences in English for the operator." },
        "language": { "type": "string", "description": "Detected language of rawMessage, BCP 47." },
        "waterLanding": { "type": "boolean", "description": "The sender is surrounded by flood water: the drone lands on the water (pontoons)." }
      }
    }
  }
}
